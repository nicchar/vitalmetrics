<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6-11 Auto-Backup-Regeln (Legacy).
  Alle sensiblen Gesundheitsdaten vom Auto-Backup ausschliessen.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
