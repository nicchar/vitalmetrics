# Kopiere diese Datei als "keystore.properties" (ohne .example)
# und trage deine echten Passwoerter ein.
#
# Die echte keystore.properties ist in .gitignore und wird NIE comitted.
#
# Wenn diese Datei fehlt, greift der Build auf die Umgebungsvariablen
# KEYSTORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD zurueck.

storePassword=DEIN_KEYSTORE_PASSWORT
keyAlias=vitalmetrics
keyPassword=DEIN_KEY_PASSWORT
