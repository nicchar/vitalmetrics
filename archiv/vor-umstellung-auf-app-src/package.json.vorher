{
  "name": "vitalmetrics",
  "version": "1.0.0",
  "description": "VitalMetrics – Biomarker & Ernährungsassistent",
  "private": true,
  "scripts": {
    "build": "node -e \"require('fs').copyFileSync('VitalMetrics.html','app/index.html')\" && echo app/index.html aktualisiert",
    "sync": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "release": "npm run sync && cd android && gradlew bundleRelease",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": "Nicole Doehring",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.2",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.0.0",
    "cordova-plugin-purchase": "^13.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "patch-package": "^8.0.1"
  }
}
